    {
      "id": "3bb86395-a195-4106-b138-305b50459db4",
      "name": "Normalize Lead & Deal Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480.0,
        300.0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.body || $json;\n\nconst firstName = String(raw.firstname || raw.first_name || '').trim();\nconst lastName = String(raw.lastname || raw.last_name || '').trim();\nconst email = String(raw.email || '').toLowerCase().trim();\nconst company = String(raw.company || raw.company_name || 'Acme Corp').trim();\nconst rawAmount = raw.deal_amount || raw.amount || 0;\nconst dealAmount = parseFloat(rawAmount) || 0.0;\n\nreturn {\n  json: {\n    firstname: firstName,\n    lastname: lastName,\n    full_name: `${firstName} ${lastName}`.trim(),\n    email: email,\n    company: company,\n    deal_amount: dealAmount,\n    ingested_at: new Date().toISOString()\n  }\n};"
      },
      "credentials": null,
      "disabled": false,
      "notesInFlow": null
    },
    {
      "id": "f7e41b5c-2fea-4fc7-80c4-eb5d75bf4f51",
      "name": "HubSpot Contact Sync",
      "type": "n8n-nodes-base.hubspot",
      "typeVersion": 2,
      "position": [
        720.0,
        300.0
      ],
      "parameters": {
        "resource": "contact",
        "operation": "createOrUpdate",
        "email": "={{ $json.email }}",
        "additionalFields": {
          "firstName": "={{ $json.firstname }}",
          "lastName": "={{ $json.lastname }}",
          "company": "={{ $json.company }}"
        }
      },
      "credentials": null,
