# ==============================================================================
# n8n MCP Server Environment Configuration
# ==============================================================================

# n8n Server Instance URL (Default: http://localhost:5678)
N8N_HOST=http://localhost:5678

# n8n Public REST API Key (Generate from n8n -> Settings -> n8n API)
N8N_API_KEY=your_n8n_api_key_here

# Network Request Timeout in Seconds (Default: 30.0)
N8N_TIMEOUT_SECONDS=30.0

# Maximum Retry Attempts with AWS Full-Jitter Backoff on 429/503 (Default: 3)
N8N_MAX_RETRIES=3

# Local or Dockerized behavioral-playwright Scraping Engine URL
# Use http://host.docker.internal:8000 when n8n runs in Docker, or http://localhost:8000 natively
BEHAVIORAL_PLAYWRIGHT_URL=http://host.docker.internal:8000

# Local Directory for 1-Click Rollback Workflow Snapshots
N8N_SNAPSHOTS_DIR=.snapshots
